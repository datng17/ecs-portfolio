# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------- Node / CRA ----------
/node_modules
/.pnp
.pnp.js
/coverage
/build
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.aws/
credentials
*.secret
*.secrets

# ---------- Terraform ----------
# .terraform.lock.hcl is intentionally COMMITTED (pins provider checksums).
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ---------- Evidence ----------
# Raw dumps may contain account IDs/ARNs/secrets before redaction.
evidence/raw/

# ---------- Tooling ----------
.agent/skills/*.zip
.codesight/
*.log
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.kiro

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
